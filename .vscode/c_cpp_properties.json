{
    "configurations": [
        {
            "name": "8051 (SDCC)",
            "includePath": [
                "${workspaceFolder}/**",
                "${SDCC_INCLUDE}",
                "${SDCC_INCLUDE}/mcs51"
            ],
            "defines": [
                "__SDCC__",
                "__SDCC_mcs51",
                "__sfr=volatile unsigned char",
                "__sbit=volatile unsigned char",
                "__at(x)=",
                "__bit=volatile unsigned char",
                "__code=",
                "__data=",
                "__xdata=",
                "__idata=",
                "__pdata=",
                "__interrupt(x)=",
                "__asm=",
                "NOP=",
                "__endasm="
            ],
            "compilerPath": "${SDCC_HOME}/bin/sdcc",
            "cStandard": "c99",
            "intelliSenseMode": "linux-gcc-x86"
        }
    ],
    "version": 4
}